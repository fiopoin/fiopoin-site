<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp|safe }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{% if archived %}{{ d.date_long }} | FIOPO Intelligence (fiopoin){% else %}FIOPO Intelligence (fiopoin) | Daily markets, money and world brief{% endif %}</title>
<meta property="og:site_name" content="FIOPO Intelligence">
<link rel="icon" type="image/svg+xml" href="{{ root }}brand/fiopoin-icon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="{{ root }}brand/fiopoin-icon-32.png">
<link rel="apple-touch-icon" href="{{ root }}brand/fiopoin-icon-180.png">
<meta name="description" content="{{ desc }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href="{{ url }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ d.hero.headline }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:image" content="https://fiopoin.com/social/{{ d.date }}.png">
<meta property="og:image:width" content="1080">
<meta property="og:image:height" content="1350">
<meta property="og:url" content="{{ url }}">
<meta property="og:locale" content="en_US">
<meta property="article:published_time" content="{{ published }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ d.hero.headline }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="https://fiopoin.com/social/{{ d.date }}.png">
<script type="application/ld+json">{{ ld|safe }}</script>
{% if cfg.google_site_verification %}<meta name="google-site-verification" content="{{ cfg.google_site_verification }}">{% endif %}
{% if cfg.bing_site_verification %}<meta name="msvalidate.01" content="{{ cfg.bing_site_verification }}">{% endif %}
{% if cfg.ga_id %}<script async src="https://www.googletagmanager.com/gtag/js?id={{ cfg.ga_id }}"></script>
<script src="{{ root }}assets/ga.js?v={{ v }}" data-id="{{ cfg.ga_id }}"></script>{% endif %}
<link rel="alternate" type="application/rss+xml" title="FIOPO Intelligence" href="https://fiopoin.com/feed.xml">
<link rel="stylesheet" href="{{ root }}assets/style.css?v={{ v }}">
</head>
<body data-gas-now="{{ d.calc.gas_now }}" data-gas-year-ago="{{ d.calc.gas_year_ago }}">

<header class="top">
  <div class="wrap">
    <a class="brand fi" href="{{ root }}" aria-label="FIOPO Intelligence home"><span class="fi-r"><img src="{{ root }}brand/fiopo-white.svg" alt="FIOPO" width="106" height="44"><span class="fi-int">Intelligence</span></span></a>
    <nav class="main" aria-label="Sections">
      <a href="#today">Today</a>
      <a href="#money">Your money</a>
      {% if d.regions %}<a href="#regions">World</a>
      <a href="#sports">Sports</a>
      <a href="#entertainment">Entertainment</a>
      <a href="#travel">Travel</a>
      <a href="#events">Events</a>{% else %}<a href="#world">World</a>
      <a href="#culture">Sports and culture</a>{% endif %}
      <a href="#tool">Calculator</a>
      <a href="{{ root }}archive/">Past editions</a>
    </nav>
  </div>
</header>
<div class="dateline"><div class="wrap"><span>{{ d.date_long }}. {{ d.edition }}{% if archived %} Archived edition.{% endif %}</span><span>Facts are sourced and dated. Our read is labeled.</span></div></div>

<section class="hero" id="top">
  <div class="wrap">
    <h1>{{ d.hero.headline }}</h1>
    <p class="dek">{{ d.hero.dek }}</p>
    <div class="ripple" role="list" aria-label="How today's top story reaches your wallet">
      {% for n in d.hero.chain %}
      <div class="node" role="listitem">
        <div class="dot">{{ loop.index }}</div>
        <h3>{{ n.label }}</h3>
        <div class="v">{{ n.value }}</div>
        <p>{{ n.text }}</p>
      </div>
      {% endfor %}
    </div>
    <p class="caption">{{ d.hero.caption }}</p>
  </div>
</section>

<div class="tape" aria-label="Market snapshot">
  <div class="wrap">
    {% for t in d.tape %}<div class="tick"><small>{{ t.label }}</small><strong>{{ t.value }}</strong><em class="{{ {'down':'up','up':'dn','flat':'flat'}[t.dir] }}">{{ t.note }}</em></div>
    {% endfor %}
  </div>
</div>

<main>
{% if d.yesterday %}
<section class="block" id="yesterday">
  <div class="wrap">
    <div class="shead"><h2>Yesterday in 60 seconds</h2><p>{{ d.yesterday.label }}. What moved, in one screen, plus how our past calls are tracking.</p></div>
    <div class="yday">
      <div class="card">
        <ul class="rows">{% for i in d.yesterday['items'] %}<li><b>{{ i.label }}</b><span>{{ i.text }}</span></li>{% endfor %}</ul>
        <p class="src">Sources: {% for src in d.yesterday.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </div>
      <div class="card score">
        <div class="kick">Our scorecard</div>
        <h3>Every FIOPO call is scored when its window closes.</h3>
        <div class="stats"><div><strong>{{ score.open }}</strong><small>open calls</small></div><div><strong>{{ score.hit }}</strong><small>came true</small></div><div><strong>{{ score.miss }}</strong><small>missed</small></div></div>
        {% if score.next %}<p class="mini">Latest open call: "{{ score.next.label }}" at {{ score.next.pct }}%, made {{ score.next.made_long }}. Scored on {{ score.next.check_long }}.</p>{% endif %}
        <p class="mini">We score the outcome we rated most likely in each forecast, once, even if we repeat it. Market odds are not counted.</p>
      </div>
    </div>
  </div>
</section>
{% endif %}
<section class="block" id="today">
  <div class="wrap">
    <div class="shead">
      <h2>Today in three tenses</h2>
      <p>What happened, what is happening now, and what could happen next, with our odds. Then the part most news skips: what it means for you.</p>
    </div>
    {% for s in d.stories %}
    <article class="story" id="{{ s.id }}">
      <header>
        <div><div class="topic">{{ s.topic }}</div><h3>{{ s.headline }}</h3></div>
        <span class="stake {{ s.stake.level }}">{{ s.stake.text }}</span>
      </header>
      <div class="tenses">
        <div class="tense t1"><h4>Happened</h4><p>{{ s.happened }}</p></div>
        <div class="tense t2"><h4>Happening</h4><p>{{ s.happening }}</p></div>
        <div class="tense t3"><h4>Could happen</h4>
          {% if s.could.odds %}<div class="odds">
            {% for o in s.could.odds %}<div class="odd"><span>{{ o.label }}</span><b>{{ o.pct }}%</b><div class="bar"><span style="width:{{ o.pct }}%"></span></div></div>
            {% endfor %}</div>{% endif %}
          {% if s.could.text %}<p>{{ s.could.text }}</p>{% endif %}
          <p class="ourread">{{ s.could.note }}</p>
        </div>
      </div>
      <div class="you"><h4>What it means for you</h4>
        <ul>{% for y in s.you %}<li>{{ y }}</li>{% endfor %}</ul>
      </div>
      <div class="watch"><span><b>Watch:</b> {{ s.watch }}</span><span class="src">{% for src in s.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span></div>
    </article>
    {% endfor %}
  </div>
</section>


{% if d.regions %}
<section class="block" id="regions">
  <div class="wrap">
    <div class="shead"><h2>Around the world</h2><p>One story per region, weighted toward where most people live. Each ends with what it means for you.</p></div>
    <div class="cards3">
      {% for c in d.regions %}<article class="card">
        <div class="kick">{{ c.region }}</div>
        <h3>{{ c.headline }}</h3>
        <p>{{ c.text }}</p>
        <div class="foryou"><b>For you:</b> {{ c.you }}</div>
        <p class="src">Covers {{ c.covers }}. {% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </article>{% endfor %}
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap duo2">
    <div id="sports">
      <div class="shead"><h2>Sports</h2><p>Global, followed by the money.</p></div>
      <div class="stack">{% for c in d.sports %}<article class="card">
          <div class="kick">{{ c.topic }}</div>
          <h3>{{ c.headline }}</h3>
          <p>{{ c.text }}</p>
          <div class="foryou"><b>For you:</b> {{ c.you }}</div>
          <p class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
        </article>{% endfor %}</div>
    </div>
    <div id="entertainment">
      <div class="shead"><h2>Entertainment</h2><p>Film, music, games and streaming.</p></div>
      <div class="stack">{% for c in d.entertainment %}<article class="card">
          <div class="kick">{{ c.topic }}</div>
          <h3>{{ c.headline }}</h3>
          <p>{{ c.text }}</p>
          <div class="foryou"><b>For you:</b> {{ c.you }}</div>
          <p class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
        </article>{% endfor %}
      {% if d.trending %}<aside class="card trend">
        <div class="kick">{{ d.trending.label }}</div>
        <ul class="rows">{% for t in d.trending['items'] %}<li><b>{{ t.where }}</b><span>{{ t.text }}</span></li>{% endfor %}</ul>
        <p class="src">{% for src in d.trending.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </aside>{% endif %}
      </div>
    </div>
  </div>
</section>

<section class="block" id="innovation">
  <div class="wrap">
    <div class="shead"><h2>Innovation and disruption</h2><p>What is changing jobs, prices or daily life, explained plainly.</p></div>
    <div class="cards3">{% for c in d.innovation %}<article class="card">
          <div class="kick">{{ c.topic }}</div>
          <h3>{{ c.headline }}</h3>
          <p>{{ c.text }}</p>
          <div class="foryou"><b>For you:</b> {{ c.you }}</div>
          <p class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
        </article>{% endfor %}</div>
  </div>
</section>

<section class="block" id="travel">
  <div class="wrap">
    <div class="shead"><h2>Escape: travel</h2><p>Hidden treasures, famous places done smarter, and the money side of getting there.</p></div>
    <div class="cards3">
      {% for c in d.travel %}<article class="card{% if c.image %} pic{% endif %}">
        {% if c.image %}<figure><img src="{{ c.image.src }}" alt="{{ c.image.alt }}" loading="lazy" referrerpolicy="no-referrer"><figcaption>Photo: {{ c.image.credit }}, <a href="{{ c.image.license_url }}" rel="noopener noreferrer license">{{ c.image.license }}</a>, via <a href="{{ c.image.source_url }}" rel="noopener noreferrer">Wikimedia Commons</a></figcaption></figure>{% endif %}
        <div class="body">
          <div class="kick">{{ c.tag }}</div>
          <h3>{{ c.headline }}</h3>
          <p>{{ c.text }}</p>
          <div class="foryou"><b>For you:</b> {{ c.you }}</div>
          <p class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
        </div>
      </article>{% endfor %}
    </div>
  </div>
</section>

<section class="block" id="picks">
  <div class="wrap">
    <div class="shead"><h2>Read and watch</h2><p>One book and one film or series worth your time this week, and why they matter now.</p></div>
    <div class="cards2">
      {% for c in d.picks %}<article class="card pick">
        <div class="tile {{ c.kind|lower }}" aria-hidden="true">{{ c.kind }}</div>
        <div class="body">
          <div class="kick">{{ c.kind }}</div>
          <h3>{{ c.title }}</h3>
          <p class="by">{{ c.by }}. {{ c.where }}.</p>
          <p>{{ c.text }}</p>
          <p class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
        </div>
      </article>{% endfor %}
    </div>
  </div>
</section>

{% if d.highlights %}
<section class="block" id="highlights">
  <div class="wrap">
    <div class="shead"><h2>Highlights</h2><p>Extraordinary accomplishments worth remembering: last week, this month and this year.</p></div>
    <div class="cards3">
      {% for k in ['week','month','year'] %}{% set h = d.highlights[k] %}<div class="card hl">
        <div class="kick">{{ h.label }}</div>
        <ul class="rows hlrows">{% for i in h['items'] %}<li><b>{{ i.date }}</b><span>{{ i.text }} <a class="srcl" href="{{ i.url }}" rel="noopener noreferrer">{{ i.source }}</a></span></li>{% endfor %}</ul>
      </div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}
<section class="block" id="events">
  <div class="wrap">
    <div class="shead"><h2>Events calendar</h2><p>The dates that move markets and prices, plus an industry track.</p></div>
    <div class="cards2">
      <div class="card"><div class="kick">Global</div><ul class="rows cal">{% for e in d.events.global %}<li><b>{{ e.when }}</b><span>{% if e.url %}<a href="{{ e.url }}" rel="noopener noreferrer">{{ e.what }}</a>{% else %}{{ e.what }}{% endif %}{% if e.where %}<em class="where">{{ e.where }}</em>{% endif %}</span></li>{% endfor %}</ul></div>
      <div class="card"><div class="kick">{{ d.events.industry_title }}</div><ul class="rows cal">{% for e in d.events.industry %}<li><b>{{ e.when }}</b><span>{% if e.url %}<a href="{{ e.url }}" rel="noopener noreferrer">{{ e.what }}</a>{% else %}{{ e.what }}{% endif %}{% if e.where %}<em class="where">{{ e.where }}</em>{% endif %}</span></li>{% endfor %}</ul>{% if d.events.industry_note %}<p class="mini">{{ d.events.industry_note }}</p>{% endif %}</div>
    </div>
    <p class="src evsrc">Sources: {% for src in d.events.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
  </div>
</section>
{% else %}
<section class="block" id="culture">
  <div class="wrap">
    <div class="shead">
      <h2>Sports and culture, followed by the money</h2>
      <p>The games and shows you love are now some of the biggest businesses on earth, and they set what you pay to watch and play.</p>
    </div>
    <div class="duo">
      {% for c in d.culture %}
      <article class="story">
        <header><div><div class="topic">{{ c.topic }}</div><h3>{{ c.headline }}</h3></div></header>
        <div class="tenses">
          <div class="tense t1"><h4>Happened</h4><p>{{ c.happened }}</p></div>
          <div class="tense t2"><h4>Happening</h4><p>{{ c.happening }}</p></div>
          <div class="tense t3"><h4>Could happen</h4><p>{{ c.could }}</p></div>
        </div>
        <div class="you"><h4>What it means for you</h4><ul>{% for y in c.you %}<li>{{ y }}</li>{% endfor %}</ul></div>
        <div class="watch"><span class="src">{% for src in c.sources %}<a href="{{ src.url }}" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span></div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="block" id="tool">
  <div class="wrap">
    <div class="tool">
      <div class="in">
        <h3>What today's news costs you</h3>
        <p class="lead">Enter your own numbers. Nothing leaves your browser.</p>
        <div class="field"><label for="gal">Gallons of gas you buy per month</label><input id="gal" type="number" min="0" value="50" inputmode="decimal"><small>A typical commuter uses 40 to 60.</small></div>
        <div class="field"><label for="debt">Variable rate debt (credit cards, HELOC)</label><input id="debt" type="number" min="0" value="8000" inputmode="decimal"><small>Balances whose rate moves with the Fed.</small></div>
        <div class="field"><label for="cash">Cash in savings</label><input id="cash" type="number" min="0" value="10000" inputmode="decimal"><small>Assumes your bank passes a hike through.</small></div>
      </div>
      <div class="out" aria-live="polite">
        <div class="res a"><small>Extra fuel cost vs a year ago, per month</small><strong id="r1">$0</strong><p>{{ d.calc.gas_note }}</p></div>
        <div class="res"><small>Extra interest if the Fed hikes 0.25%, per year</small><strong id="r2">$0</strong><p>On variable balances, once lenders reprice.</p></div>
        <div class="res g"><small>Extra savings interest, per year</small><strong id="r3">$0</strong><p>Only if your account pays near the Fed rate.</p></div>
        <div class="net" id="net"></div>
      </div>
    </div>
  </div>
</section>

<section class="block" id="how">
  <div class="wrap">
    <div class="shead"><h2>How FIOPO works</h2><p>Built for people who are tired of news that leaves them worried but no wiser.</p></div>
    <div class="how">
      <div><h3>Facts carry a date and a source</h3><p>Every number links to where it came from. If we cannot confirm something, we say so.</p></div>
      <div><h3>Our read is labeled</h3><p>Odds and outlooks are our judgment, marked as such, and checked later against what actually happened.</p></div>
      <div><h3>Every story ends with you</h3><p>We trace each event to the decisions it touches: buying, borrowing, saving, working, traveling.</p></div>
    </div>
    <div class="why">
      <strong>~50%</strong>
      <p>of people now say they actively avoid the news, and trust has fallen to a record low across 48 countries. The answer is not more headlines. It is fewer, clearer ones that help you decide something. <span class="src"><a rel="noopener noreferrer" href="https://www.pulse.bot/media/news/dnr-what-audiences-actually-need-from-you-right-now-28129de2-b045-45c3-95f1-db19a640dc4c/">Reuters Institute Digital News Report 2026</a></span></p>
    </div>
  </div>
</section>
</main>

<section class="signup">
  <div class="wrap">
    <div><div class="lockup"><img src="{{ root }}brand/fiopoin-logo-navy.svg" alt="fiopoin"></div><h2>The five minute morning brief, in your inbox.</h2></div>
    <form id="sf" novalidate>
      <label for="em" style="position:absolute;left:-9999px">Email address</label>
      <input id="em" type="email" placeholder="you@example.com" autocomplete="email">
      <button type="submit">Join the list</button>
      <p class="note" id="sn">Email signup is opening soon. Until then, a new edition is posted here every morning. Questions or tips: <a href="mailto:hello@fiopoin.com">hello@fiopoin.com</a></p>
    </form>
  </div>
</section>

<section class="follow" aria-labelledby="follow-h">
  <div class="wrap">
    <div class="follow-head">
      <h2 id="follow-h">Follow us</h2>
      <p>Scan a code or tap a name. New posts every day from the morning edition.</p>
    </div>
    <ul class="follow-grid">
      <li><a href="https://www.instagram.com/fiopoin/" rel="noopener"><img src="{{ root }}brand/qr-instagram.svg" alt="QR code: FIOPO Intelligence on Instagram" width="132" height="132"><span class="fl-net">Follow us on Instagram</span><span class="fl-handle">@fiopoin</span></a></li>
      <li><a href="https://x.com/fiopoinx" rel="noopener"><img src="{{ root }}brand/qr-x.svg" alt="QR code: FIOPO Intelligence on X" width="132" height="132"><span class="fl-net">Follow us on X</span><span class="fl-handle">@fiopoinx</span></a></li>
      <li><a href="https://www.linkedin.com/company/fiopoin/" rel="noopener"><img src="{{ root }}brand/qr-linkedin.svg" alt="QR code: FIOPO Intelligence on LinkedIn" width="132" height="132"><span class="fl-net">Follow us on LinkedIn</span><span class="fl-handle">FIOPO Intelligence</span></a></li>
    </ul>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="fgrid">
      <a class="lockup" href="{{ root }}" aria-label="fiopoin, FIOPO Intelligence, home"><img src="{{ root }}brand/fiopoin-logo-white.svg" alt="fiopoin"></a>
      <div>
        <nav aria-label="Footer"><a href="{{ root }}">Today</a><a href="{{ root }}archive/">Past editions</a><a href="https://fiopoin.com/feed.xml">RSS feed</a><a href="mailto:hello@fiopoin.com">Contact: hello@fiopoin.com</a><a href="{{ root }}about.html">About</a><a href="{{ root }}privacy.html">Privacy</a></nav>
        <p style="margin-top:12px">FIOPO Intelligence is general information, not financial, legal or medical advice. Make decisions with a professional who knows your situation.</p>
        <p class="sister" style="margin-top:8px">Also from the FIOPO family: <a href="https://carbonenergynexus.com/">Carbon Energy Nexus</a> · <a href="https://uticamidstream.com/">Utica Midstream</a></p>
        <p style="margin-top:8px"><b style="color:#fff">FIOPO Intelligence.</b> Intelligence for prosperity. © {{ d.date[:4] }} fiopoin.com. Updated every morning, Central Time.</p>
      </div>
    </div>
  </div>
</footer>
<script src="{{ root }}assets/calc.js?v={{ v }}"></script>
</body>
</html>
